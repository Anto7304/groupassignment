Options -Indexes
DirectoryIndex frontend/js/landing.php

RewriteEngine On
RewriteBase /

# If the request is for a real file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, route to landing.php
RewriteRule ^$ frontend/js/landing.php [L]
RewriteRule ^index\.php$ frontend/js/landing.php [L]
