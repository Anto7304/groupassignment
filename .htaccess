# .htaccess - Minimal configuration, no redirects
DirectoryIndex index.php
Require all granted

# Turn off rewrite engine completely
RewriteEngine Off

# Allow all files to be accessed directly
<Files "*">
    Require all granted
</Files>

# Set correct MIME types for CSS and JS
<FilesMatch "\.(css|js)$">
    Header set Content-Type text/css
</FilesMatch>